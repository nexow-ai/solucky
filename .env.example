# Copy to .env for the operator scripts (bun run admin, crank, monitor,
# localnet, e2e). Bun reads it from the working directory. Never commit .env.

# RPC endpoint, without any auth token (default: devnet). The scripts print it.
SOLANA_RPC_URL=
# Its WebSocket endpoint, if it is not SOLANA_RPC_URL with ws(s)://
SOLANA_WS_URL=
# The provider's auth token (QuickNode): sent as an x-token header on HTTP and
# as the last path segment of the WebSocket URL
SOLANA_AUTH_TOKEN=
# Path to the operator keypair (default: ~/.config/solana/id.json), or the
# keypair's byte array itself, for CI secrets
SOLANA_KEYPAIR=
SOLANA_KEYPAIR_JSON=
# Program address; leave empty for the address in idl/solucky.json
SOLUCKY_PROGRAM_ID=

# Highest ticket number in all three games (numbers go from 0 to this one).
# `admin init` and `localnet` write it to the on-chain config; change it later
# with `bun run admin set --max-number <n>`.
SOLUCKY_MAX_NUMBER=21000000

# Optional: Slack or Discord webhook for `bun run monitor` alerts
ALERT_WEBHOOK_URL=

# Optional, for draw notifications: the site's URL and its NUXT_PUSH_SECRET
# (`bun run vapid`). The crank reports each draw there.
SOLUCKY_APP_URL=
SOLUCKY_PUSH_SECRET=
