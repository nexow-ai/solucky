# Copy to .env and adjust. Every NUXT_PUBLIC_ value ends up in the browser.

# devnet, testnet, mainnet or localnet
NUXT_PUBLIC_CLUSTER=devnet
# The other deployment, for the network choice in the settings menu (each
# cluster is its own site): on Mainnet set the test site's URL
# (https://devnet.solucky.me), on Devnet the Mainnet one (https://solucky.me).
# Empty shows that side as coming soon.
NUXT_PUBLIC_MAINNET_URL=
NUXT_PUBLIC_TESTNET_URL=
# RPC endpoint, without its auth token; leave empty for the cluster's public
# endpoint. Use a dedicated provider in production: public endpoints are
# rate-limited (HTTP 429).
NUXT_PUBLIC_RPC_URL=
# Websocket endpoint, if it is not the RPC URL with ws(s)://; without the token
NUXT_PUBLIC_RPC_WS_URL=
# Auth token of the RPC provider (QuickNode), added to both URLs as their last
# path segment. It reaches the browser too: restrict the endpoint to your domains.
NUXT_PUBLIC_RPC_TOKEN=
# Program address; leave empty for the address in idl/solucky.json
NUXT_PUBLIC_PROGRAM_ID=
# Priority fee of the app's transactions, in micro-lamports per compute unit
# (0: none). The Mainnet site uses 50000.
NUXT_PUBLIC_PRIORITY_FEE=
# Highest ticket number in the three games, shown until the on-chain config
# loads (the config decides). Keep it equal to SOLUCKY_MAX_NUMBER.
NUXT_PUBLIC_MAX_NUMBER=21000000

# Public URL of the site (no trailing slash), for absolute links in social cards
NUXT_PUBLIC_SITE_URL=
# The same URL, for the hreflang and canonical links between languages
NUXT_PUBLIC_I18N_BASE_URL=

# Optional links shown in the footer (hidden when empty)
NUXT_PUBLIC_TWITTER_URL=
NUXT_PUBLIC_DISCORD_URL=

# Draw notifications (optional): `bun run vapid` prints all three. Only the
# public key reaches the browser; the other two are server-only secrets
# (`wrangler secret put` on Cloudflare). An empty key hides the play page's bell.
NUXT_PUBLIC_VAPID_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_PUSH_SECRET=

# Server only. A provider's RPC URL, token included, for the site's RPC proxy
# (/api/rpc, used when NUXT_PUBLIC_RPC_URL is empty on Mainnet, whose public
# endpoint refuses browsers) and its crank. Empty: the cluster's public endpoint.
NUXT_RPC_UPSTREAM=
# The site's crank (server/tasks/crank.ts, every minute): the byte array of a
# lightly funded key that pays its fees (empty turns it off), and its priority
# fee in micro-lamports per compute unit.
NUXT_CRANK_KEYPAIR=
NUXT_CRANK_PRIORITY_FEE=
