// Cloudflare Workers deployment of the app: `bun run deploy` from the repo root.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "solucky",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./.output/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Nitro's cloudflare_durable preset sends every WebSocket of the play page's
  // live table to this one Durable Object, so all players share one table.
  "durable_objects": {
    "bindings": [{ "name": "$DurableObject", "class_name": "$DurableObject" }],
  },
  "migrations": [{ "tag": "v1-live-table", "new_sqlite_classes": ["$DurableObject"] }],
  // Draw notification subscriptions (server/utils/push.ts). The first deploy
  // creates the namespace and writes its id here: commit it.
  "kv_namespaces": [{ "binding": "PUSH" }],
  // Apex + www; Cloudflare manages DNS and certificates for these.
  "routes": [
    { "pattern": "solucky.me", "custom_domain": true },
    { "pattern": "www.solucky.me", "custom_domain": true },
  ],
  // Public settings read by the app at runtime (see app/.env.example).
  "vars": {
    "NUXT_PUBLIC_CLUSTER": "devnet",
    "NUXT_PUBLIC_SITE_URL": "https://solucky.me",
    // The same URL, so every language's hreflang and canonical links are absolute.
    "NUXT_PUBLIC_I18N_BASE_URL": "https://solucky.me",
  },
}
